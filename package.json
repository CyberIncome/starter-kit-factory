{
  "name": "starter-kit-factory",
  "version": "1.1.0",
  "description": "A local Windows desktop factory for personalized service-business starter kits.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "factory": "electron . --cli",
    "build": "vite build",
    "package:win": "npm run build && electron-builder --win",
    "test": "node --test tests/**/*.test.mjs"
  },
  "keywords": [
    "etsy",
    "templates",
    "desktop",
    "generator"
  ],
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "archiver": "^8.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.26.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.starterkitfactory.desktop",
    "productName": "Starter Kit Factory",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Starter-Kit-Factory-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CyberIncome",
        "repo": "starter-kit-factory",
        "releaseType": "release"
      }
    ]
  }
}
